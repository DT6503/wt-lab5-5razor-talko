@page
@model wt_lab5_5razor_talko.Pages.Couriers.IndexModel
@{
    ViewData["Title"] = "Курьеры";
}

<style>
    .courier-avatar {
        width: 130px;
        height: 130px;
        border-radius: 50%;
        object-fit: cover;
        border: 3px solid #d4af37;
        margin: 0 auto;
        display: block;
        box-shadow: 0 4px 8px rgba(0,0,0,0.1);
    }

    .badge-gold {
        background-color: #f5e6c8;
        color: #8b6914;
        font-weight: bold;
        font-size: 0.9rem;
    }

    .badge-deliveries {
        background-color: #6b8e23;
        color: white;
        font-size: 0.9rem;
    }
</style>

<div class="container py-4">
    <div class="text-center mb-5">
        <h1 class="fw-bold" style="font-size: 3rem; color: #4a3d24;">✦ Наши курьеры ✦</h1>
        <p class="fst-italic text-muted" style="font-size: 1.2rem;">Быстрая и вежливая доставка — наша гордость</p>
    </div>

    <div class="row g-4 justify-content-center">
        @foreach (var courier in Model.Couriers)
        {
            <div class="col-12 col-md-6 col-lg-4">
                <div class="card h-100 shadow-sm rounded-4 text-center p-4">

                    <img src="@courier.ImageUrl" class="courier-avatar mb-3" alt="@courier.FullName" />

                    <h4 class="card-title fw-bold" style="font-family: 'Playfair Display', serif; font-style: italic; color: #4a3d24;">
                        @courier.FullName
                    </h4>

                    <p class="text-muted mb-2">🚗 @courier.Vehicle</p>

                    <div class="d-flex justify-content-center gap-2 mb-3">
                        <span class="badge badge-gold px-3 py-2 rounded-3">⭐ @courier.Rating</span>
                        <span class="badge badge-deliveries px-3 py-2 rounded-3">@courier.DeliveriesCount доставок</span>
                    </div>

                    <p class="card-text text-muted mb-0 fst-italic">
                        @courier.Description
                    </p>
                </div>
            </div>
        }
    </div>
</div>