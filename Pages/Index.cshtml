@page
@model IndexModel
@{
    ViewData["Title"] = "Главная";
}

<div class="container mt-5 text-center">
    <h1 class="display-4" style="font-family: 'Playfair Display', serif; font-style: italic; color: #4a3d24;">
        Служба доставки еды
    </h1>
    <p class="lead mt-3 fst-italic" style="color: #6b8e23;">
        Razor Pages · ASP.NET Core
    </p>

    <!-- Кнопка ведет на страницу списка блюд -->
    <a asp-page="/Dishes/Index" class="btn btn-primary btn-lg mt-4 px-5 py-3" style="background-color: #4a5d23; border-color: #4a5d23; font-weight: bold;">
        Перейти к блюдам
    </a>
</div>