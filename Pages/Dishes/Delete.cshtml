@page
@model wt_lab5_5razor_talko.Pages.Dishes.DeleteModel

<div class="container mt-4">
    <div class="card shadow rounded-4 border-danger">
        <div class="card-header bg-danger text-white">
            <h3 class="mb-0">Удалить блюдо</h3>
        </div>
        <div class="card-body">
            <p>Вы уверены, что хотите удалить <strong>@Model.Dish?.Name</strong>?</p>

            <form method="post">
                <input type="hidden" name="id" value="@Model.Dish?.Id" />
                <button type="submit" class="btn btn-danger">Удалить</button>
                <a asp-page="/Dishes/Index" class="btn btn-secondary">Отмена</a>
            </form>
        </div>
    </div>
</div>