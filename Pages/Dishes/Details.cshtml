@page
@model wt_lab5_5razor_talko.Pages.Dishes.DetailsModel
@{
    ViewData["Title"] = Model.Dish?.Name ?? "Блюдо";
}

<div class="container mt-4">
    <div class="card shadow rounded-4">
        <div class="row g-0">
            <div class="col-md-5">
                <img src="@Model.Dish?.ImageUrl" class="img-fluid rounded-start-4"
                     alt="@Model.Dish?.Name" />
            </div>
            <div class="col-md-7">
                <div class="card-body">
                    <h2 class="card-title">@Model.Dish?.Name</h2>
                    <p class="text-muted">@Model.Dish?.Description</p>
                    <p><span class="badge bg-secondary">@Model.Dish?.Category</span></p>
                    <p class="fs-4 fw-bold">@Model.Dish?.Price руб.</p>
                    <p>
                        Статус:
                        @if (Model.Dish?.IsAvailable == true)
                        {
                                <span class="badge bg-success">Доступно</span>
                        }
                        else
                        {
                                <span class="badge bg-danger">Нет в наличии</span>
                        }
                    </p>
                    <a asp-page="/Dishes/Index" class="btn btn-secondary">← Назад к списку</a>
                </div>
            </div>
        </div>
    </div>
</div>