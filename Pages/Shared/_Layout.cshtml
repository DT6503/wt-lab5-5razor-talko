<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - wt_lab5_5razor_talko</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/wt_lab5_5razor_talko.styles.css" asp-append-version="true" />
</head>
<body class="d-flex flex-column min-vh-100">
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark gold-navbar shadow">
            <div class="container">
                <a class="navbar-brand brand-script" asp-page="/Index">
                    ✦ Доставка еды ✦
                </a>
                <button class="navbar-toggler" type="button"
                        data-bs-toggle="collapse" data-bs-target="#navMenu">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="navMenu">
                    <ul class="navbar-nav ms-auto">
                        <li class="nav-item">
                            <a class="nav-link" href="/">Главная</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="/Dishes/Index">Блюда</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="/Couriers/Index">Курьеры</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="/Restaurants/Index">Рестораны</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="/Dishes/Create">Добавить</a>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <!-- Основной контент, который растягивается -->
    <main role="main" class="flex-grow-1">
        <div class="container pb-3 mt-4">
            @RenderBody()
        </div>
    </main>

    <!-- Футер с mt-auto, чтобы прижиматься к низу -->
    <footer class="border-top footer text-muted mt-auto" style="background-color: #2b2419; padding: 20px 0;">
        <div class="container text-center" style="color: #f5e6c8;">
            &copy; 2026 - wt_lab5_5razor_talko <a asp-page="/Privacy" style="color: #d4af37; text-decoration: none;"></a>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>